OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT=30s
OPENAI_MAX_RETRIES=0
OPENAI_MAX_OUTPUT_TOKENS=600

# Redis defaults match the root docker-compose.yml development service.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s

HAMMERLY_AI_CONVERSATION_MAX_MESSAGES=20
HAMMERLY_AI_CONVERSATION_TTL=86400
HAMMERLY_AI_RESPONSE_CACHE_TTL=900
HAMMERLY_AI_RATE_LIMIT_REQUESTS=20
HAMMERLY_AI_RATE_LIMIT_WINDOW_SECONDS=60
