OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=600
HAMMERLY_AI_INTERNAL_TOKEN=

# Safe demo-off defaults. Set both to true for the full Redis/Kafka path.
HAMMERLY_REDIS_ENABLED=false
HAMMERLY_KAFKA_ENABLED=false

# Redis defaults match the root docker-compose.yml development service.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s

HAMMERLY_AI_CONVERSATION_MAX_MESSAGES=20
HAMMERLY_AI_CONVERSATION_TTL=86400
HAMMERLY_AI_RESPONSE_CACHE_TTL=900
HAMMERLY_AI_RATE_LIMIT_REQUESTS=20
HAMMERLY_AI_RATE_LIMIT_WINDOW_SECONDS=60

# Phase 5 provider transport and resilience controls.
HAMMERLY_AI_LLM_CONNECT_TIMEOUT=3s
HAMMERLY_AI_LLM_REQUEST_TIMEOUT=30s
HAMMERLY_AI_LLM_FIRST_TOKEN_TIMEOUT=12s
HAMMERLY_AI_LLM_IDLE_TIMEOUT=15s
HAMMERLY_AI_LLM_MAX_ATTEMPTS=3
HAMMERLY_AI_LLM_RETRY_INITIAL_BACKOFF=250ms
HAMMERLY_AI_LLM_RETRY_MULTIPLIER=2.0
HAMMERLY_AI_LLM_RETRY_JITTER=0.25
HAMMERLY_AI_LLM_MAX_CONCURRENT_CALLS=32
HAMMERLY_AI_LLM_MAX_WAIT=0ms
HAMMERLY_AI_LLM_CB_WINDOW_SIZE=20
HAMMERLY_AI_LLM_CB_MINIMUM_CALLS=10
HAMMERLY_AI_LLM_CB_FAILURE_RATE=50
HAMMERLY_AI_LLM_CB_SLOW_CALL_RATE=80
HAMMERLY_AI_LLM_CB_SLOW_CALL_DURATION=10s
HAMMERLY_AI_LLM_CB_OPEN_WAIT=20s
HAMMERLY_AI_LLM_CB_HALF_OPEN_CALLS=3
HAMMERLY_AI_STREAM_MAX_CONCURRENT=1100
HAMMERLY_AI_HTTP_MAX_CONNECTIONS=2000
HAMMERLY_AI_HTTP_ACCEPT_COUNT=1000
HAMMERLY_AI_STREAM_TIMEOUT=5m

# Explicit loadtest profile only; uncomment only for an isolated benchmark target.
# Never enable this profile in production.
# SPRING_PROFILES_ACTIVE=loadtest
MOCK_LLM_FIRST_TOKEN_DELAY_MS=100
MOCK_LLM_TOKEN_INTERVAL_MS=20
MOCK_LLM_TOKEN_COUNT=8
MOCK_LLM_TIMEOUT_DELAY_MS=30s
MOCK_LLM_429_RATE=0.0
MOCK_LLM_5XX_RATE=0.0
MOCK_LLM_TIMEOUT_RATE=0.0
MOCK_LLM_CONNECTION_FAILURE_RATE=0.0
MOCK_LLM_AFTER_TOKEN_FAILURE_RATE=0.0

# Kafka is an asynchronous side effect and is never required for a chat response.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
HAMMERLY_KAFKA_AI_EVENTS_TOPIC=hammerly.ai.events.v1
HAMMERLY_KAFKA_AI_JOBS_TOPIC=hammerly.ai.jobs.v1
HAMMERLY_AI_SUMMARY_AFTER_MESSAGES=10
HAMMERLY_AI_SUMMARY_REQUEST_MARKER_TTL=7d
