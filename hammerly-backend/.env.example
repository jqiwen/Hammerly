HAMMERLY_SEED_ENABLED=true
HAMMERLY_DEBUG_ENDPOINT_ENABLED=true
HAMMERLY_AI_URL=http://localhost:5001
HAMMERLY_AI_DIAGNOSTIC_ENABLED=true
HAMMERLY_AI_INTERNAL_TOKEN=
HAMMERLY_AI_CONNECT_TIMEOUT=2s
