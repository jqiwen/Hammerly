# Required for Hammerly Core. Use a Supabase JDBC URL for the default stack.
# For --profile local-db, use jdbc:postgresql://postgres:5432/hammerly and
# provide the matching SUPABASE_DB_USERNAME/SUPABASE_DB_PASSWORD values below.
SUPABASE_DB_URL=
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=
HAMMERLY_DB_SSL_MODE=require

# Required. Generate a long random value for local JWT signing.
JWT_SECRET=

# Optional shared Core-to-AI trust token. Set the same value for both services.
HAMMERLY_AI_INTERNAL_TOKEN=

# Deterministic and free by default. Set HAMMERLY_AI_PROFILE=live and provide
# OPENAI_API_KEY only when paid provider calls are explicitly intended.
HAMMERLY_AI_PROFILE=loadtest
OPENAI_API_KEY=

# Keep paid demo infrastructure off unless it is intentionally being used.
# Docker Compose still starts its local Redis/Kafka containers; these flags
# choose whether Hammerly AI uses them.
HAMMERLY_REDIS_ENABLED=false
HAMMERLY_KAFKA_ENABLED=false

# Optional local-db profile. SUPABASE_DB_PASSWORD must match POSTGRES_PASSWORD.
POSTGRES_DB=hammerly
POSTGRES_USER=hammerly
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5433

# Optional local overrides.
FRONTEND_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
