# Leave these blank for the local pgvector database. Set all three to use Supabase.
SUPABASE_DB_URL=
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=
HAMMERLY_DB_SSL_MODE=disable

# Required. Generate a long random value for local JWT signing.
JWT_SECRET=

# Optional shared Core-to-AI trust token. Set the same value for both services.
HAMMERLY_AI_INTERNAL_TOKEN=
HAMMERLY_INTERNAL_TOKEN_REQUIRED=false

# Deterministic and free by default. Set HAMMERLY_AI_PROFILE=live and provide
# OPENAI_API_KEY only when paid provider calls are explicitly intended.
HAMMERLY_AI_PROFILE=loadtest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=200

# The full local stack uses its own Redis and Kafka. Kafka remains outside the
# synchronous chat response path; disabling it pauses durable knowledge relay.
HAMMERLY_REDIS_ENABLED=true
HAMMERLY_KAFKA_ENABLED=true
HAMMERLY_MARKETPLACE_CACHE_ENABLED=true
HAMMERLY_MARKETPLACE_CACHE_OPERATION_TIMEOUT=500ms
REDIS_CONNECT_TIMEOUT=250ms
REDIS_COMMAND_TIMEOUT=250ms

# Local pgvector database. SUPABASE_DB_PASSWORD defaults to this value in Compose.
POSTGRES_DB=hammerly
POSTGRES_USER=hammerly
POSTGRES_PASSWORD=hammerly
POSTGRES_HOST_PORT=5433

# Optional local overrides.
FRONTEND_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Real RAG is enabled locally with deterministic/free embeddings by default.
HAMMERLY_RAG_ENABLED=true
HAMMERLY_AI_EMBEDDING_PROVIDER=deterministic
HAMMERLY_AI_EMBEDDING_MODEL=text-embedding-3-small
HAMMERLY_RAG_TOP_K=3
HAMMERLY_RAG_SIMILARITY_THRESHOLD=0.25
HAMMERLY_RAG_CACHE_TTL=5m
HAMMERLY_RAG_KB_VERSION_CACHE_TTL=45s
HAMMERLY_RAG_TIMEOUT=1200ms
HAMMERLY_AI_CONTEXT_RECENT_TURNS=3
HAMMERLY_AI_CONTEXT_MAX_CHARS=8000
HAMMERLY_RAG_CHUNK_TOKENS=650
HAMMERLY_RAG_CHUNK_OVERLAP_TOKENS=100
